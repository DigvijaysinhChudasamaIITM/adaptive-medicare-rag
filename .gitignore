# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/

# Environment / secrets
.env
.env.local

# Test / lint caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary generated artifacts
artifacts/tmp/

# Python packaging
build/
dist/
*.egg-info/

# Development inspection output
artifacts/*_inspection.txt

# Generated candidate chunk corpora
artifacts/chunks/

# Generated candidate vector indexes.
# Keep only the selected production index in Git so a fresh clone can run
# the API without rebuilding every candidate strategy.
artifacts/indexes/*
!artifacts/indexes/selected/
!artifacts/indexes/selected/index.faiss
!artifacts/indexes/selected/metadata.json